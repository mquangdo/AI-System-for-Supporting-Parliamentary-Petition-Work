# ---- LLM: chọn provider mặc định ----
# Provider mặc định cho get_llm(). Giá trị: nvidia | groq
LLM_PROVIDER=groq

# ---- Provider NVIDIA (ChatNVIDIA) ----
# Cách 1: NVIDIA NIM tự host (OpenAI-compatible URL, VD Gemma qua vLLM/NIM).
LLM_BASE_URL=https://.../v1
# Key cho NIM/vLLM (thường chấp nhận giá trị bất kỳ; bỏ trống mặc định dùng "EMPTY")
LLM_API_KEY=
# Cách 2: NVIDIA API Catalog hosted (build.nvidia.com) — không đặt LLM_BASE_URL.
# Key real từ build.nvidia.com, chỉ cần khi không trỏ NIM tự host.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-120b

# ---- Provider Groq ----
GROQ_API_KEY=
GROQ_MODEL=

# ---- Fallback generic (dùng chung khi provider không có key riêng) ----
OPENAI_LLM_MODEL=openai/gpt-oss-20b

# ---- Qdrant (mặc định local theo docker-compose.yml) ----
QDRANT_URL=http://localhost:6333
# Chỉ cần cho Qdrant Cloud; bỏ trống khi chạy local
QDRANT_API_KEY=
QDRANT_COLLECTION=vpl_chunks

# ---- Embedding query (khớp index đã dựng) ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Tham số tra cứu ----
RETRIEVE_TOP_K=6
TIMEOUT_SEC=120

# ---- Override system prompt cho orchestrator (tùy chọn) ----
# SYSTEM_PROMPT=...